# Copy to .env and fill in (never commit .env).

# SSH target (LAN)
NAS_HOST=192.168.1.50
NAS_USER=deploy
NAS_SSH_PORT=22

# Remote directory for synced compose stacks (must exist or be creatable by NAS_USER)
NAS_REMOTE_STACKS_DIR=/volume1/docker/stacks

# Optional: limit deploy to one stack directory name under ./stacks/
# NAS_STACK=example
