# Reference values for flash-odio-cli and Raspberry Pi Imager customisation.
#
# Target hardware: Raspberry Pi Zero W / WH (32-bit, armhf odio image).
# For Pi Zero 2 W later: ODIO_IMAGE=arm64 or flash-odio-cli --arm64

HOSTNAME=pi-odio-test
ODIO_IMAGE=armhf
WIFI_SSID=SSID_HERE
WIFI_PSK=PASSWORD_HERE
# Set to true for hidden SSID (adds hidden: true in cloud-init network-config)
WIFI_HIDDEN=false
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... user@host
