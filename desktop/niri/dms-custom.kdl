// Custom DMS-related niri configuration managed by nix-maid.
// Keep DMS auto-generated files under ~/.config/niri/dms unmanaged.
//
// Do not set background-effect.blur=true on ^dms:.* — that applies niri blur to
// the full layer rectangle (often near full-screen for popouts/modals) and washes
// out the desktop. Regional frosted-glass blur is handled by DMS BlurService
// (ext-background-effect-v1 / WindowBlur).

layer-rule {
    match namespace=".*"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^dms:.*"
    background-effect {
        blur false
        xray false
    }
}
