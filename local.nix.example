# Copy to local.nix (gitignored) for machine-specific toggles.
#
#   cp local.nix.example local.nix
#
{
  # Disable llama.cpp CUDA stack for faster nixos-rebuild when updating other apps.
  # Re-enable before using llama-swap on port 9292.
  neo.ai.llama.enable = false;

  # Optional: pin llama-cpp after building once:
  #   nix build .#llama-cpp-cuda --no-link
  # neo.ai.llama.package = /nix/store/…-llama-cpp-…;
}
